(*
  Open Itinerary KDL Schema v0.2
  https://kdl.dev — KDL Document Language

  The grammar is KDL's native syntax. This file documents the
  Open Itinerary node types, properties, and validation rules
  on top of the standard KDL parser.
*)

(* ── Top-level ─────────────────────────────────────────────── *)
itinerary "<name>" {
  summary   "<text>"                          (* optional *)
  tz        "<IANA timezone>"                 (* optional, e.g. America/Los_Angeles *)
  cur       "<ISO 4217>"                      (* optional, e.g. USD *)
  tags      "<tag1>, <tag2>, ..."             (* optional, comma-separated *)
  generated_by "<name>"                       (* optional *)
  created_at   "<ISO 8601 datetime>"          (* optional *)

  {stop}                                      (* 1+ stops *)
  {route}                                     (* 0+ routes *)
  {day}                                       (* 1+ days *)
}

(* ── Stop ──────────────────────────────────────────────────── *)
stop "<id>" {
  name      "<display name>"                  (* required *)
  goal      "<purpose>"                       (* required *)
  cat       "<category>"                      (* optional *)
  addr      "<address>"                       (* optional *)
  coord     <lat> <lng>                       (* optional, 2 positional values *)
  place_id  "<ns:id>"                         (* optional, e.g. gplaces:ChIJ... *)
  tz        "<IANA>"                          (* optional *)
  dur       min=<hours> max=<hours>           (* optional, decimal hours *)
  cost      amt=<number> cur="<ISO 4217>"     (* optional *)
  dep       "<HH:MM>"                         (* optional *)
  arr       "<HH:MM>"                         (* optional *)
  url       "<url>"                           (* optional *)
  note      "<text>"                          (* optional *)
  {alt}                                       (* optional *)
}

category = "accommodation" | "food" | "drink" | "attraction"
         | "nature" | "viewpoint" | "transport" | "rest"
         | "shopping" | "activity" | "other" ;

(* ── Alt (alternative to a stop) ───────────────────────────── *)
alt {
  name      "<name>"                          (* required *)
  goal      "<purpose>"                       (* required *)
  cat       "<category>"                      (* optional *)
  addr      "<address>"                       (* optional *)
  dur       min=<hours> max=<hours>           (* optional *)
  note      "<text>"                          (* optional *)
}

(* ── Route ─────────────────────────────────────────────────── *)
route "<id>" {
  from      "<stop-id>"                       (* required *)
  to        "<stop-id>"                       (* required *)
  mode      "<mode>"                          (* required *)
  dur       min=<hours> max=<hours>           (* optional *)
  dist      <km>                              (* optional, positional value *)
  dep       "<HH:MM>"                         (* optional *)
  arr       "<HH:MM>"                         (* optional *)
  cost      amt=<number> cur="<ISO 4217>"     (* optional *)
  url       "<url>"                           (* optional *)
  note      "<text>"                          (* optional *)
}

mode = "drive" | "fly" | "train" | "bus" | "walk"
     | "bike" | "transit" | "ferry" | "other" ;

(* ── Day ───────────────────────────────────────────────────── *)
day date="<YYYY-MM-DD>" {
  note      "<text>"                          (* optional *)
  tz        "<IANA>"                          (* optional *)
  {item}                                      (* timeline items *)
  {flex}                                      (* flex blocks *)
}

(* ── Day items ─────────────────────────────────────────────── *)
item type="stop"  ref="<stop-id>"             (* stop reference *)
item type="route" ref="<route-id>"            (* route reference *)
item type="note"  txt="<text>"                (* inline note *)

(* ── Flex block (choose N from options) ────────────────────── *)
flex pick=<n> {
  option type="stop"  ref="<id>"             (* stop option *)
  option type="route" ref="<id>"             (* route option *)
  option type="note"  txt="<text>"           (* note option *)
}

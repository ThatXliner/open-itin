{
  "name": "open-itin-agent-format",
  "version": "0.1.0",
  "description": "Token-optimized format for Open Itinerary — parser, serializer, and JSON converter",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:browser": "esbuild src/browser-entry.ts --outfile=dist/open-itin-bundle.js --target=es2020 --format=iife --global-name=OpenItin --bundle --minify"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.16",
    "kdljs": "^0.3.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "packageManager": "npm@10.9.9"
}

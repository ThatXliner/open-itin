itinerary "Tokyo Weekend" {
  summary "A 2-day sprint through Tokyo — Shibuya, Shinjuku, Asakusa, and Akihabara. Temples in the morning, arcades at night, yakitori in between."
  tz "Asia/Tokyo"
  cur "JPY"
  tags "city-break, tokyo, japan, food, transit"
  generated_by "claude-sonnet-4"
  created_at "2026-05-11T10:00:00Z"
  stop "haneda" {
  name "Haneda Airport (HND)"
  goal "Arrive in Tokyo"
  cat "transport"
  addr "Hanedakuko, Ota City, Tokyo 144-0041"
  note "Arriving Friday night. Take Keikyu Line to Shinagawa, transfer to JR Yamanote to Shibuya."
  }
  stop "hotel-shibuya" {
  name "Shibuya Excel Hotel Tokyu"
  goal "Overnight stay — connected to Shibuya Station, unbeatable location"
  cat "accommodation"
  addr "1-12-2 Dogenzaka, Shibuya City, Tokyo 150-0043"
    cost amt=25000
  url "https://www.tokyuhotels.co.jp/shibuya-e"
  note "Mark City complex, directly connected to the station. Ask for a high floor — the scramble crossing view is worth it."
    alt {
    name "Dormy Inn Premium Shibuya Jingumae"
    goal "Budget-friendly alternative with an onsen on the top floor"
    cat "accommodation"
    addr "6-24-4 Jingumae, Shibuya City, Tokyo 150-0001"
    }
  }
  stop "shibuya-crossing" {
  name "Shibuya Scramble Crossing"
  goal "Stand at the world's busiest pedestrian crossing — it's a Tokyo rite of passage"
  cat "viewpoint"
  addr "2-2-1 Dogenzaka, Shibuya City, Tokyo 150-0043"
    dur min=0.25 max=0.5
  note "Best viewed from Starbucks Tsutaya 2F (free, but busy) or Magnet 7F rooftop (¥500, less crowded). Go early — it's a mob by 10am."
  }
  stop "meiji-jingu" {
  name "Meiji Jingu"
  goal "Walk through massive torii gates into a forest in the middle of Tokyo — the city's most important Shinto shrine"
  cat "attraction"
  addr "1-1 Yoyogikamizonocho, Shibuya City, Tokyo 151-8557"
    dur min=1 max=2
  note "Free entry. Closes at sunset. Buy an omamori (charm) — they make great small gifts. The sake barrel display near the entrance is photo-worthy."
  }
  stop "harajuku" {
  name "Takeshita Street (Harajuku)"
  goal "Crepes, vintage shops, and peak Tokyo people-watching"
  cat "shopping"
  addr "1-chome Jingumae, Shibuya City, Tokyo 150-0001"
    dur min=1 max=2
  note "The crepe stands at the entrance are the real deal. For vintage, duck into the side streets — Takeshita itself is mostly fast fashion."
    alt {
    name "Cat Street, Harajuku"
    goal "Quieter, cooler alternative to Takeshita — indie boutiques and better coffee"
    cat "shopping"
    note "Connects Harajuku to Shibuya. Good if Takeshita's crowds get to you."
    }
  }
  stop "omotesando" {
  name "Omotesando"
  goal "Walk Tokyo's Champs-Élysées — flagship architecture and design shops"
  cat "shopping"
  addr "4-chome Jingumae, Shibuya City, Tokyo 150-0001"
    dur min=0.75 max=1.5
  note "Stop at Koffee Mameya for a pour-over — it's a tiny standing-room-only coffee bar in a converted warehouse."
  }
  stop "shinjuku-gyoen" {
  name "Shinjuku Gyoen National Garden"
  goal "Escape the concrete — greenhouse, French Formal Garden, and Japanese garden in one park"
  cat "nature"
  addr "11 Naitomachi, Shinjuku City, Tokyo 160-0014"
    dur min=1 max=2
    cost amt=500
  note "Closes 5:30pm, last entry 5pm. The Japanese garden section is the highlight — find the tea house."
  }
  stop "omoide-yokocho" {
  name "Omoide Yokocho (Piss Alley)"
  goal "Dinner in a post-war alleyway of yakitori stalls — the Tokyo that tourists hope to find"
  cat "food"
  addr "1-2 Nishishinjuku, Shinjuku City, Tokyo 160-0023"
    dur min=1.5 max=3
  note "Cash only at most stalls. Get there before 6pm for a seat — the best stalls fit 6 people and fill instantly. Try the shiitake skewers even if you think you want meat."
    alt {
    name "Nakajima, Shinjuku"
    goal "Michelin-starred sardine set lunch for ~¥800 — one of Tokyo's best food deals"
    cat "food"
    note "Lunch only. Line forms at 11am. The iwashi teishoku is what you're here for."
    }
  }
  stop "golden-gai" {
  name "Golden Gai"
  goal "Bar hop through 200+ micro-bars in six narrow alleys — each bar seats 5-8 people max"
  cat "drink"
  addr "1-1-6 Kabukicho, Shinjuku City, Tokyo 160-0021"
  note "Many bars have cover charge (~¥500-1000). Bar Albatross is foreigner-friendly and a good starter. Don't take photos in the alleys without asking — some bar owners are strict about it."
  }
  stop "senso-ji" {
  name "Sensō-ji"
  goal "Tokyo's oldest temple — get there before the crowds for the best experience"
  cat "attraction"
  addr "2-3-1 Asakusa, Taito City, Tokyo 111-0032"
    dur min=0.75 max=1.5
  note "Nakamise-dori shops open ~10am. Before 9am you'll have the main hall nearly to yourself. Get your fortune (omikuji) — if it's bad, tie it to the rack and leave the bad luck behind."
  }
  stop "sumida-river" {
  name "Sumida River Walk"
  goal "Walk the river terrace toward Skytree — best photo angles of the tower"
  cat "viewpoint"
  addr "Sumida River Terrace, Taito City, Tokyo 111-0032"
    dur min=0.25 max=0.75
  note "Coffee at Fuglen Asakusa — Scandinavian-Japanese hybrid in a restored ryokan. The river walk is a 5-min detour from Sensō-ji."
  }
  stop "asakusa-lunch" {
  name "Lunch in Asakusa"
  goal "Unagi (eel) or tempura in one of Tokyo's oldest neighborhoods"
  cat "food"
  addr "Asakusa, Taito City, Tokyo 111-0032"
  note "Unatoto for casual unagi (counter seating, ¥2000-3000). Daikokuya for tempura (cash only, the tendon is legendary)."
    alt {
    name "Sometaro, Asakusa"
    goal "Cook-your-own okonomiyaki in a 60-year-old restaurant — fun and interactive"
    cat "food"
    note "Floor seating on tatami. Great if you want a break from sushi and ramen."
    }
  }
  stop "akihabara" {
  name "Akihabara Electric Town"
  goal "Retro games, arcades, anime, and the sensory overload of Tokyo's tech district"
  cat "attraction"
  addr "1-chome Sotokanda, Chiyoda City, Tokyo 101-0021"
    dur min=2 max=4
  note "Super Potato (retro games, 5th floor) is the pilgrimage site. Yodobashi Camera for everything else. The Sega arcades are gone but Taito HEY is still going strong."
  }
  stop "tonkatsu-marugo" {
  name "Tonkatsu Marugo"
  goal "Legendary tonkatsu — thick-cut, perfectly fried, worth the line"
  cat "food"
  addr "1-8-14 Sotokanda, Chiyoda City, Tokyo 101-0021"
    cost amt=2500
  note "Opens 11:30, line forms early. Only ~12 counter seats. The hire-katsu (lean fillet) and rosu-katsu (fatty loin) are both correct — get the rosu."
    alt {
    name "Kyushu Jangara Akihabara"
    goal "Famous tonkotsu ramen — faster than Marugo, just as satisfying"
    cat "food"
    addr "3-11-6 Sotokanda, Chiyoda City, Tokyo 101-0021"
    note "Open all afternoon. The karashi (spicy) miso tonkotsu is what you want."
    }
  }
  stop "haneda-depart" {
  name "Haneda Airport (HND)"
  goal "Catch the 8pm flight home"
  cat "transport"
  addr "Hanedakuko, Ota City, Tokyo 144-0041"
  note "Arrive by 6pm. Keikyu Line from Shinagawa. The observation deck at Terminal 3 is a solid farewell — open-air views of the runway and Tokyo Bay."
  }
  route "haneda-to-shibuya" {
  from "haneda"
  to "hotel-shibuya"
  mode "train"
    dur min=0.5 max=1
    cost amt=580
  note "Keikyu Line to Shinagawa, transfer to JR Yamanote (counter-clockwise) to Shibuya."
  }
  route "shibuya-to-meiji" {
  from "hotel-shibuya"
  to "meiji-jingu"
  mode "walk"
    dur min=0.25 max=0.5
  note "Walk through Miyashita Park for a rooftop detour — good for a quick coffee at the start."
  }
  route "meiji-to-harajuku" {
  from "meiji-jingu"
  to "harajuku"
  mode "walk"
    dur min=0.1 max=0.25
  note "Exit Meiji Jingu via the Harajuku gate — Takeshita Street is right there."
  }
  route "harajuku-to-omotesando" {
  from "harajuku"
  to "omotesando"
  mode "walk"
    dur min=0.15 max=0.3
  note "Walk down Omotesando Ave. Stop at Koffee Mameya for pour-over."
  }
  route "omotesando-to-shinjuku" {
  from "omotesando"
  to "shinjuku-gyoen"
  mode "transit"
    dur min=0.25 max=0.5
  note "Tokyo Metro Chiyoda Line from Omotesando to Shinjuku-gyoemmae (3 stops)."
  }
  route "gyoen-to-omoide" {
  from "shinjuku-gyoen"
  to "omoide-yokocho"
  mode "walk"
    dur min=0.2 max=0.3
  note "Exit garden at Shinjuku gate, walk through the station area toward the west exit."
  }
  route "omoide-to-golden-gai" {
  from "omoide-yokocho"
  to "golden-gai"
  mode "walk"
    dur min=0.1 max=0.2
  note "Through the east side of Shinjuku station, past Kabukicho signs. 10 min walk."
  }
  route "shibuya-to-asakusa" {
  from "hotel-shibuya"
  to "senso-ji"
  mode "transit"
    dur min=0.5 max=0.75
  note "JR Yamanote to Ueno, transfer to Tokyo Metro Ginza Line to Asakusa. ~40 min."
  }
  route "sensoji-to-sumida" {
  from "senso-ji"
  to "sumida-river"
  mode "walk"
    dur min=0.05 max=0.1
  note "Cross the street behind Sensō-ji to reach the river terrace. 5 min."
  }
  route "sumida-to-akihabara" {
  from "sumida-river"
  to "akihabara"
  mode "transit"
    dur min=0.2 max=0.4
  note "Tsukuba Express from Asakusa to Akihabara (2 stops)."
  }
  route "akihabara-to-haneda" {
  from "akihabara"
  to "haneda-depart"
  mode "train"
    dur min=0.5 max=0.75
  note "JR Yamanote to Shinagawa, transfer to Keikyu Line to HND."
  }
  day date="2026-06-13" {
  note "West Tokyo — Shibuya, Harajuku, Omotesando, Shinjuku. Day 1 is a greatest-hits tour of Tokyo's west side."
    item type="note" txt="Grab breakfast at the hotel or a konbini — FamilyMart onigiri + Boss coffee is the authentic Tokyo morning"
    item type="stop" ref="shibuya-crossing"
    item type="route" ref="shibuya-to-meiji"
    item type="stop" ref="meiji-jingu"
    item type="route" ref="meiji-to-harajuku"
    item type="stop" ref="harajuku"
    item type="route" ref="harajuku-to-omotesando"
    item type="stop" ref="omotesando"
    item type="route" ref="omotesando-to-shinjuku"
    item type="stop" ref="shinjuku-gyoen"
    item type="route" ref="gyoen-to-omoide"
    item type="stop" ref="omoide-yokocho"
    flex pick=1 {
      option type="note" txt="Karaoke in Shinjuku — try a Kan Kan location for cheap all-you-can-drink"
      option type="stop" ref="golden-gai"
      option type="note" txt="Late-night ramen at Ichiran Shinjuku (open 24h)"
    }
    item type="note" txt="Last Yamanote train ~12:50am — don't miss it back to Shibuya"
  }
  day date="2026-06-14" {
  note "East Tokyo — Asakusa, Akihabara, and depart. Temples in the morning, arcades in the afternoon."
    item type="route" ref="shibuya-to-asakusa"
    item type="stop" ref="senso-ji"
    item type="route" ref="sensoji-to-sumida"
    item type="stop" ref="sumida-river"
    item type="stop" ref="asakusa-lunch"
    item type="route" ref="sumida-to-akihabara"
    item type="stop" ref="akihabara"
    flex pick=1 {
      option type="stop" ref="tonkatsu-marugo"
      option type="note" txt="Ramen at Kyushu Jangara Akihabara (famous tonkotsu, open all afternoon)"
    }
    item type="route" ref="akihabara-to-haneda"
    item type="stop" ref="haneda-depart"
  }
}
